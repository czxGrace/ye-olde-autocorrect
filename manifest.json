{
  "manifest_version": 3,
  "name": "Ye Olde Autocorrect",
  "version": "1.0",
  "description": "Autocorrects thy typing into the English of 1600, on every site.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ye Olde Autocorrect"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["words.js", "ui.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/*"], "matches": ["<all_urls>"] }
  ]
}
